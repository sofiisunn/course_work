generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model supplier {
  supplier_id           Int     @id @default(autoincrement())
  supplier_name         String  @unique @db.VarChar(100)
  supplier_phone_number String  @unique @db.VarChar(16)
  supplier_email        String  @unique @db.VarChar(254)
  brand                 brand[]
}

model brand {
  brand_id    Int       @id @default(autoincrement())
  brand_title String    @unique @db.VarChar(100)
  supplier_id Int
  supplier    supplier  @relation(fields: [supplier_id], references: [supplier_id], onDelete: Restrict)
  product     product[]
}

model category {
  category_id      Int                @id @default(autoincrement())
  category_title   String             @unique @db.VarChar(100)
  product_category product_category[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product {
  product_id                 Int                 @id @default(autoincrement())
  brand_id                   Int
  product_title              String              @db.VarChar(150)
  product_price              Decimal             @db.Decimal(8, 2)
  product_expiration_date    DateTime?           @db.Date
  product_pao_months         Int?                @db.SmallInt
  product_volume_value       Int
  product_volume_unit        product_volume_unit
  product_application_method String?             @db.Text
  product_stock_quantity     Int                 @default(0)
  order_item                 order_item[]
  brand                      brand               @relation(fields: [brand_id], references: [brand_id], onDelete: Restrict)
  product_category           product_category[]
  review                     review[]

  @@index([brand_id])
  @@index([product_price])
}

model customer {
  customer_id           Int      @id @default(autoincrement())
  customer_first_name   String   @db.VarChar(100)
  customer_last_name    String   @db.VarChar(100)
  customer_email        String   @unique @db.VarChar(254)
  customer_phone_number String   @unique @db.VarChar(16)
  customer_birth_date   DateTime @db.Date
  customer_bonuses      Int      @default(0)
  orders                orders[]
  review                review[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  orders_id               Int               @id @default(autoincrement())
  customer_id             Int
  orders_date             DateTime          @default(now()) @db.Timestamp(6)
  orders_status           order_status_type
  orders_delivery_address String
  order_item              order_item[]
  customer                customer          @relation(fields: [customer_id], references: [customer_id], onDelete: Restrict)

  @@index([customer_id, orders_date])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_item {
  orders_id           Int
  product_id          Int
  order_item_quantity Int
  order_item_price    Decimal @db.Decimal(8, 2)
  orders              orders  @relation(fields: [orders_id], references: [orders_id], onDelete: Cascade)
  product             product @relation(fields: [product_id], references: [product_id], onDelete: Restrict)

  @@id([orders_id, product_id])
}

model product_category {
  product_id  Int
  category_id Int
  category    category @relation(fields: [category_id], references: [category_id], onDelete: Cascade)
  product     product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@id([product_id, category_id])
  @@index([category_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model review {
  review_id      Int      @id @default(autoincrement())
  review_rating  Int
  review_comment String?  @db.Text
  product_id     Int
  product        product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  customer_id    Int
  customer       customer @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)

  @@unique([customer_id, product_id])
  @@index([product_id])
}

enum order_status_type {
  New
  In_Progress @map("In Progress")
  Shipped
  Delivered
  Cancelled
}

enum product_volume_unit {
  ml
  g
  pcs
}
